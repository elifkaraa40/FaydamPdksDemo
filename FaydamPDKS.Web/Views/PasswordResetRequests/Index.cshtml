@model IReadOnlyList<FaydamPDKS.Core.DTOs.PasswordResetRequestListItemDto>
@{ ViewData["Title"] = "Şifre Sıfırlama Talepleri"; }
<section class="hero compact-hero">
    <div><p class="eyebrow">Hesap güvenliği</p><h1>Şifre sıfırlama talepleri</h1><p>Personelin yönetici yardımıyla oluşturduğu bekleyen talepleri inceleyin.</p></div><span class="summary-pill">@Model.Count bekleyen</span>
</section>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (TempData["TemporaryPassword"] is string temporaryPassword)
{
    <section class="temporary-password-panel" role="alert"><div><strong>Tek kullanımlık geçici şifre</strong><p>Bu şifre sayfadan ayrıldıktan sonra yeniden gösterilmeyecektir. Personele güvenli bir kanaldan iletin.</p></div><code>@temporaryPassword</code></section>
}
<section class="panel">
    @if (Model.Count == 0) { <div class="panel-empty"><strong>Bekleyen şifre sıfırlama talebi yok.</strong><p>Yeni talepler burada görüntülenecektir.</p></div> }
    else
    {
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Personel</th><th>E-posta</th><th>Talep zamanı</th><th class="text-end">Karar</th></tr></thead><tbody>
        @foreach (var item in Model)
        {
            <tr><td><strong>@item.EmployeeName</strong><small>@item.EmployeeNumber</small></td><td>@item.Email</td><td>@item.RequestedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td>
                <form asp-action="Review" method="post" class="password-reset-review"><input type="hidden" name="id" value="@item.Id" /><input name="note" maxlength="500" placeholder="Karar notu (isteğe bağlı)" /><button class="btn btn-sm btn-outline-danger" name="approve" value="false" type="submit">Reddet</button><button class="btn btn-sm btn-primary" name="approve" value="true" type="submit">Sıfırla ve onayla</button></form>
            </td></tr>
        }
        </tbody></table></div>
    }
</section>
