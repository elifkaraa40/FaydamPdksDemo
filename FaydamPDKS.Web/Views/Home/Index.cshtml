@model FaydamPDKS.Core.DTOs.DashboardDto
@{
    ViewData["Title"] = "Kontrol Paneli";
    var culture = new System.Globalization.CultureInfo("tr-TR");
    var total = Math.Max(1, Model.TotalPersonnel);
    var presentRate = Math.Round(Model.PresentCount * 100d / total);
    var lateRate = Math.Round(Model.LateCount * 100d / total);
    var leaveRate = Math.Round(Model.OnLeaveCount * 100d / total);
    var missingRate = Math.Round(Model.MissingRecordCount * 100d / total);
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}

<section class="dashboard-heading" aria-labelledby="page-title">
    <div>
        <p class="eyebrow">@Model.WorkDate.ToDateTime(TimeOnly.MinValue).ToString("dd MMMM yyyy · dddd", culture)</p>
        <h1 id="page-title">Kontrol Paneli</h1>
        <p>Ekibinizin devam durumunu, istisnaları ve bekleyen işlemleri tek ekrandan izleyin.</p>
    </div>
    <nav class="dashboard-quick-links" aria-label="Hızlı işlemler">
        <a asp-controller="WorkCalendar" asp-action="Index" title="Tarih seçin" aria-label="Çalışma takvimini aç">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z" /></svg>
        </a>
        <a asp-controller="AttendanceCorrections" asp-action="Index" title="Puantaj düzeltmelerini aç" aria-label="Puantaj düzeltmelerini aç">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7-4 4 4 4M3 11h13m1-4 4 4-4 4m4-4H8" /></svg>
        </a>
        <a asp-controller="Reports" asp-action="Index" title="Raporu göster" aria-label="Puantaj raporunu göster">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V9m5 11V4m5 16v-7m5 7V7M2 20h20" /></svg>
        </a>
        <a asp-controller="Home" asp-action="Account" asp-route-section="appearance" title="Görünüm ayarları" aria-label="Görünüm ayarlarını aç">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"/></svg>
        </a>
    </nav>
</section>

<section class="metric-grid" aria-label="Günlük özet">
    <button class="metric-card" type="button" data-personnel-status="present"><span class="metric-icon success">✓</span><div><p>İş yerinde</p><strong>@Model.PresentCount</strong><small>Toplam @Model.TotalPersonnel personel</small></div></button>
    <button class="metric-card" type="button" data-personnel-status="late"><span class="metric-icon warning">↗</span><div><p>Geç başlayan</p><strong>@Model.LateCount</strong><small>İlk girişlere göre</small></div></button>
    <button class="metric-card" type="button" data-personnel-status="leave"><span class="metric-icon info">◷</span><div><p>İzinli</p><strong>@Model.OnLeaveCount</strong><small>Onaylanmış izinler</small></div></button>
    <button class="metric-card" type="button" data-personnel-status="missing"><span class="metric-icon danger">!</span><div><p>Giriş kaydı yok</p><strong>@Model.MissingRecordCount</strong><small>İzinli olmayan personel</small></div></button>
</section>

<section class="panel dashboard-personnel-detail" data-personnel-detail hidden aria-live="polite">
    <div class="panel-heading">
        <div><p class="eyebrow">Personel ayrıntısı</p><h2 data-personnel-detail-title></h2></div>
        <button type="button" class="personnel-detail-close" data-personnel-detail-close aria-label="Personel ayrıntısını kapat">×</button>
    </div>
    @foreach (var group in new[]
    {
        (Key: "present", Title: $"İş yerinde ({Model.PresentPersonnel.Count})", Description: "Bugün giriş kaydı bulunan personeller", Personnel: Model.PresentPersonnel),
        (Key: "late", Title: $"Geç başlayan ({Model.LatePersonnel.Count})", Description: "İlk girişini vardiya başlangıcından sonra yapan personeller", Personnel: Model.LatePersonnel),
        (Key: "leave", Title: $"İzinli ({Model.OnLeavePersonnel.Count})", Description: "Bugün için onaylanmış izni bulunan personeller", Personnel: Model.OnLeavePersonnel),
        (Key: "missing", Title: $"Giriş kaydı yok ({Model.MissingRecordPersonnel.Count})", Description: "İzinli olmadığı halde bugün giriş kaydı bulunmayan personeller", Personnel: Model.MissingRecordPersonnel)
    })
    {
        <div class="personnel-detail-group" data-personnel-group="@group.Key" data-personnel-title="@group.Title" hidden>
            <p>@group.Description</p>
            @if (group.Personnel.Count == 0)
            {
                <div class="personnel-detail-empty">Bu durumda personel bulunmuyor.</div>
            }
            else
            {
                <ul>
                    @foreach (var employee in group.Personnel)
                    {
                        var initials = string.Concat(employee.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0]));
                        <li><span class="avatar">@initials</span><div><strong>@employee.Name</strong><small>@(string.IsNullOrWhiteSpace(employee.EmployeeNumber) ? "Personel numarası yok" : employee.EmployeeNumber)</small></div></li>
                    }
                </ul>
            }
        </div>
    }
    @foreach (var day in Model.DailyAttendance)
    {
        @foreach (var group in new[]
        {
            (Key: "ontime", Label: "Zamanında", Description: "Vardiya başlangıç saatine uygun giriş yapan personeller", Personnel: day.OnTimePersonnel),
            (Key: "late", Label: "Geç başlayan", Description: "İlk girişini vardiya başlangıcından sonra yapan personeller", Personnel: day.LatePersonnel),
            (Key: "leave", Label: "İzinli", Description: "Bu tarih için onaylanmış izni bulunan personeller", Personnel: day.OnLeavePersonnel),
            (Key: "missing", Label: "Kayıt yok", Description: "İzinli olmadığı halde giriş kaydı bulunmayan personeller", Personnel: day.MissingRecordPersonnel)
        })
        {
            var groupKey = $"daily-{day.WorkDate:yyyy-MM-dd}-{group.Key}";
            var groupTitle = $"{day.WorkDate.ToDateTime(TimeOnly.MinValue).ToString("dd MMMM yyyy", culture)} · {group.Label} ({group.Personnel.Count})";
            <div class="personnel-detail-group" data-personnel-group="@groupKey" data-personnel-title="@groupTitle" hidden>
                <p>@group.Description</p>
                @if (group.Personnel.Count == 0)
                {
                    <div class="personnel-detail-empty">Bu durumda personel bulunmuyor.</div>
                }
                else
                {
                    <ul>
                        @foreach (var employee in group.Personnel)
                        {
                            var initials = string.Concat(employee.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0]));
                            <li><span class="avatar">@initials</span><div><strong>@employee.Name</strong><small>@(string.IsNullOrWhiteSpace(employee.EmployeeNumber) ? "Personel numarası yok" : employee.EmployeeNumber)</small></div></li>
                        }
                    </ul>
                }
            </div>
        }
    }
</section>

<div class="dashboard-chart-grid">
    <section class="panel attendance-chart-panel" aria-labelledby="attendance-chart-title">
        <div class="panel-heading">
            <div><p class="eyebrow">Anlık görünüm</p><h2 id="attendance-chart-title">Çalışan devam durumu</h2></div>
            <a asp-controller="Reports" asp-action="Index">Detaylı rapor →</a>
        </div>
        <div class="attendance-chart-body">
            <div class="attendance-donut" data-attendance-chart aria-label="@Model.TotalPersonnel çalışanın @Model.PresentCount kadarı iş yerinde, @Model.LateCount kadarı geç başlamış, @Model.OnLeaveCount kadarı izinli, @Model.MissingRecordCount kadarının giriş kaydı yok">
                <svg class="attendance-rings" viewBox="0 0 240 240" aria-label="Çalışan devam durumu renkli halkaları">
                    <circle class="attendance-ring-track track-present" cx="120" cy="120" r="104"></circle>
                    <circle class="attendance-ring-value ring-present" cx="120" cy="120" r="104" pathLength="100" stroke-dasharray="@(presentRate.ToString("0.##", invariant)) 100" tabindex="0" role="button" aria-label="İş yerinde: @Model.PresentCount çalışan, yüzde @presentRate" data-ring-label="İş yerinde" data-ring-count="@Model.PresentCount" data-ring-rate="%@presentRate" data-personnel-status="present"></circle>
                    <circle class="attendance-ring-track track-late" cx="120" cy="120" r="84"></circle>
                    <circle class="attendance-ring-value ring-late" cx="120" cy="120" r="84" pathLength="100" stroke-dasharray="@(lateRate.ToString("0.##", invariant)) 100" tabindex="0" role="button" aria-label="Geç başlayan: @Model.LateCount çalışan, yüzde @lateRate" data-ring-label="Geç başlayan" data-ring-count="@Model.LateCount" data-ring-rate="%@lateRate" data-personnel-status="late"></circle>
                    <circle class="attendance-ring-track track-leave" cx="120" cy="120" r="64"></circle>
                    <circle class="attendance-ring-value ring-leave" cx="120" cy="120" r="64" pathLength="100" stroke-dasharray="@(leaveRate.ToString("0.##", invariant)) 100" tabindex="0" role="button" aria-label="İzinli: @Model.OnLeaveCount çalışan, yüzde @leaveRate" data-ring-label="İzinli" data-ring-count="@Model.OnLeaveCount" data-ring-rate="%@leaveRate" data-personnel-status="leave"></circle>
                    <circle class="attendance-ring-track track-missing" cx="120" cy="120" r="44"></circle>
                    <circle class="attendance-ring-value ring-missing" cx="120" cy="120" r="44" pathLength="100" stroke-dasharray="@(missingRate.ToString("0.##", invariant)) 100" tabindex="0" role="button" aria-label="Kayıt yok: @Model.MissingRecordCount çalışan, yüzde @missingRate" data-ring-label="Kayıt yok" data-ring-count="@Model.MissingRecordCount" data-ring-rate="%@missingRate" data-personnel-status="missing"></circle>
                </svg>
                <button class="attendance-donut-center" type="button" aria-label="Toplam çalışan görünümüne dön" data-ring-reset data-default-label="Toplam çalışan" data-default-count="@Model.TotalPersonnel" data-default-rate="Bir renge dokunun">
                    <span data-ring-center-label>Toplam çalışan</span>
                    <strong data-ring-center-count>@Model.TotalPersonnel</strong>
                    <small data-ring-center-rate>Bir renge dokunun</small>
                </button>
            </div>
            <ul class="chart-legend">
                <li><i class="legend-present"></i><span>İş yerinde</span><strong>@Model.PresentCount</strong><small>%@presentRate</small></li>
                <li><i class="legend-late"></i><span>Geç başlayan</span><strong>@Model.LateCount</strong><small>%@lateRate</small></li>
                <li><i class="legend-leave"></i><span>İzinli</span><strong>@Model.OnLeaveCount</strong><small>%@leaveRate</small></li>
                <li><i class="legend-missing"></i><span>Kayıt yok</span><strong>@Model.MissingRecordCount</strong><small>%@missingRate</small></li>
            </ul>
        </div>
    </section>

    <section class="panel distribution-panel" aria-labelledby="distribution-title">
        <div class="panel-heading"><div><p class="eyebrow">Günlük durum dağılımı</p><h2 id="distribution-title">Son 7 çalışma günü</h2></div><small>Düne kadar</small></div>
        <div class="daily-status-legend" aria-label="Grafik renkleri">
            <span><i class="legend-present"></i>Zamanında</span>
            <span><i class="legend-late"></i>Geç</span>
            <span><i class="legend-leave"></i>İzinli</span>
            <span><i class="legend-missing"></i>Kayıt yok</span>
        </div>
        <div class="bar-chart stacked-status-chart" aria-label="Son yedi çalışma gününün personel devam durumu dağılımı">
            @foreach (var day in Model.DailyAttendance)
            {
                <div class="daily-stack-column">
                    <div class="daily-stack" aria-label="@day.WorkDate.ToString("dd MMMM", culture) personel dağılımı">
                        @foreach (var segment in new[]
                        {
                            (Key: "missing", Label: "Kayıt yok", Css: "stack-missing", Personnel: day.MissingRecordPersonnel),
                            (Key: "leave", Label: "İzinli", Css: "stack-leave", Personnel: day.OnLeavePersonnel),
                            (Key: "late", Label: "Geç başlayan", Css: "stack-late", Personnel: day.LatePersonnel),
                            (Key: "ontime", Label: "Zamanında", Css: "stack-ontime", Personnel: day.OnTimePersonnel)
                        })
                        {
                            if (segment.Personnel.Count > 0)
                            {
                                <button type="button" class="daily-stack-segment @segment.Css" style="--segment-count:@segment.Personnel.Count" data-personnel-status="daily-@(day.WorkDate.ToString("yyyy-MM-dd"))-@segment.Key" aria-label="@day.WorkDate.ToString("dd MMMM", culture), @segment.Label: @segment.Personnel.Count personel" title="@segment.Label: @segment.Personnel.Count personel"><span>@segment.Personnel.Count</span></button>
                            }
                        }
                    </div>
                    <strong>@day.TotalPersonnel</strong>
                    <small>@day.WorkDate.ToString("dd MMM", culture)</small>
                </div>
            }
        </div>
    </section>
</div>

<div class="content-grid dashboard-lists">
    <section class="panel" id="attendance" aria-labelledby="attendance-title">
        <div class="panel-heading"><div><p class="eyebrow">Canlı görünüm</p><h2 id="attendance-title">Son hareketler</h2></div><a asp-controller="Reports" asp-action="Index">Tümünü gör</a></div>
        @if (Model.RecentMovements.Count == 0)
        {
            <div class="panel-empty"><strong>Bugün henüz hareket yok.</strong><p>Terminal veya mobil uygulamadan gelen kayıtlar burada görünecek.</p></div>
        }
        else
        {
            <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Personel</th><th>İşlem</th><th>Bölge</th><th class="text-end">Zaman</th></tr></thead><tbody>
            @foreach (var movement in Model.RecentMovements)
            {
                var isEntry = movement.EventType.Equals("Giris", StringComparison.OrdinalIgnoreCase);
                <tr><td><strong>@movement.EmployeeName</strong><small>@movement.EmployeeCode</small></td><td><span class="status @(isEntry ? "success" : "neutral")">@(isEntry ? "Giriş" : "Çıkış")</span></td><td>@movement.ZoneName</td><td class="text-end">@movement.OccurredAt.ToString("HH:mm")<small>@movement.OccurredAt.ToString("dd MMM", culture)</small></td></tr>
            }
            </tbody></table></div>
        }
    </section>

    <aside class="panel" id="requests" aria-labelledby="requests-title">
        <div class="panel-heading"><div><p class="eyebrow">İş listeniz</p><h2 id="requests-title">Onay bekleyenler</h2></div><span class="count">@Model.PendingLeaveCount</span></div>
        @if (Model.PendingLeaves.Count == 0)
        {
            <div class="panel-empty"><strong>Bekleyen talep yok.</strong><p>Tüm izin talepleri sonuçlandırılmış.</p></div>
        }
        else
        {
            <ul class="request-list">@foreach (var leave in Model.PendingLeaves) { var initials = string.Concat(leave.EmployeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])); <li><span class="avatar">@initials</span><div><strong>@leave.EmployeeName</strong><small>@leave.LeaveType izni</small></div><time datetime="@leave.StartDate.ToString("yyyy-MM-dd")">@leave.StartDate.ToString("dd MMM", culture)</time></li> }</ul>
        }
        <a class="btn btn-light w-100" asp-controller="LeaveRequests" asp-action="Index">Talepleri incele</a>
    </aside>
</div>
